# 阿里云百炼平台配置
BAILIAN_API_KEY=your-bailian-api-key-here
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/api/v1/
BAILIAN_LLM_MODEL=qwen-plus
BAILIAN_EMBEDDING_MODEL=text-embedding-v2
BAILIAN_RERANKER_MODEL=gte-rerank

# 数据库配置
DATABASE_URL=sqlite+aiosqlite:///./smart_customer_service.db

# JWT 配置（生产环境请使用强密钥）
JWT_SECRET_KEY=your-secret-key-please-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# RAG 配置
RAG_SIMILARITY_THRESHOLD=0.8
RAG_TOP_K=10
RAG_RRF_K=60
RAG_RERANK_TOP_K=3

# 服务配置
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173
DEBUG=true
